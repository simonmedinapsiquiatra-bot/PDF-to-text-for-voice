    "esbuild": "^0.28.2",
    "pdfjs-dist": "^6.2.108",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "dependencies": {
    "@types/diff-match-patch": "^1.0.36",

{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    /* Reescribe las extensiones .ts a .js al emitir. El runtime de Node de
       Vercel transpila api/*.ts fichero a fichero (sin empaquetarlos) y solo
       despliega los .js resultantes, sin tocar los especificadores: un
       "./prompts.ts" en api/ apunta a un fichero que no existe en la función y
       la tumba al arrancar (ERR_MODULE_NOT_FOUND → HTTP 500
       FUNCTION_INVOCATION_FAILED en cada petición). Hoy api/gemini.ts es
       autónomo, así que esto es un seguro para cuando vuelva a dividirse. */
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "api/**/*.ts"],
  "exclude": []
}
